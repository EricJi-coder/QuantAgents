# Copy to .env (chmod 600). Never commit .env. Nothing here can enable real-money trading.

# QuantDinger Agent Gateway (paper venue). Issue a token with:
#   scripts/quantdinger_local.sh start && scripts/quantdinger_local.sh issue-token
QUANTDINGER_BASE_URL=http://127.0.0.1:5055
QUANTDINGER_AGENT_TOKEN=

# LLM provider key(s) for TradingAgents research. Only the providers named in
# config/default.yaml (llm.provider / quick_provider / deep_provider / formalizer_provider)
# are required. Anthropic keys: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Optional TradingAgents data vendor key (its default vendor is yfinance, which needs none).
# ALPHA_VANTAGE_API_KEY=
